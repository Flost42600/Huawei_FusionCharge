        "description": "Use the account of the FusionSolar app. The subdomain is the first part of the address shown in your browser once logged in to FusionSolar, for example uni004eu5.",
        "data": {
          "username": "Username",
          "password": "Password",
          "subdomain": "FusionSolar subdomain"
        }
      },
      "captcha": {
        "title": "Security code",
